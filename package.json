{
  "name": "repcard",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env src/db/seed/index.ts",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "ai": "^7.0.77",
    "babel-preset-expo": "^57.0.6",
    "better-auth": "^1.7.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-modules-jsi": "^57.0.7",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.2.6",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
