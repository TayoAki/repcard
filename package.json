    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "patch-package": "^8.0.1",
