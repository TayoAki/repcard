# Local dev (docker compose): npm run db:up
DATABASE_URL=postgres://repcard:repcard@localhost:5433/repcard
EXPO_PUBLIC_API_URL=http://localhost:8081
BETTER_AUTH_URL=http://localhost:8081
BETTER_AUTH_SECRET=generate-with: openssl rand -base64 32

# Optional: enables AI coach + AI plan generation (falls back gracefully without)
AI_GATEWAY_API_KEY=

# Social sign-in (set both halves per provider: server creds + client flag)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
EXPO_PUBLIC_AUTH_GOOGLE=0
EXPO_PUBLIC_AUTH_APPLE=0
# Password reset emails (logged to server console when unset)
RESEND_API_KEY=
EMAIL_FROM=

# Workout cover images: uploads to ImageKit CDN when set; falls back otherwise
IMAGEKIT_PRIVATE_KEY=

# Sign in with Apple (native): set APPLE_ENABLED=1 on server + EXPO_PUBLIC_AUTH_APPLE=1 on client,
# and enable the "Sign in with Apple" capability on the App ID. No client secret needed for native.
APPLE_ENABLED=0

# RepCard Pro (RevenueCat). Without these the paywall shows "coming soon" and
# nothing is gated. Set the public SDK key(s), then configure products/offerings
# in the RevenueCat dashboard with an entitlement named "pro".
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
