{
  "expo": {
    "name": "RepCard",
    "slug": "repcard",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "repcard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tayoaki.repcard",
      "supportsTablet": false
    },
    "android": {
      "package": "com.tayoaki.repcard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#04120C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04120C",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RepCard to access photos so you can pick a workout cover."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/images/icon.png"
  }
}